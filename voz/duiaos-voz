def preparar_texto(texto):
    """Texto de conversa → texto para ser falado (sem marcações, endereços e símbolos soltos)."""
    texto = re.sub(r"```.*?```", " ", texto, flags=re.S)
    texto = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", texto)
    texto = re.sub(r"https?://\S+", " ", texto)
    texto = re.sub(r"(^|\n)\s*(#{1,6}|[-*+•]|\d+[.)])\s+", r"\1", texto)
    texto = re.sub(r"[*_`#>|~]+", "", texto)
    texto = re.sub(r"[\U0001F000-\U0001FAFF☀-➿]", "", texto)            # emojis não são falados
    texto = re.sub(r"(\d)\s*°C?", r"\1 graus", texto)
    texto = re.sub(r"(\d)\s*%", r"\1 por cento", texto)
    texto = re.sub(r"\b(\d{1,3}(?:\.\d{3})+)(?!\d|\.\d)", lambda m: m.group(1).replace(".", ""), texto)   # 1.430 → 1430
    texto = re.sub(r"R\$\s*(\d+),(\d{2})\b", lambda m: _reais(m.group(1), m.group(2)), texto)
    texto = re.sub(r"R\$\s*(\d+)\b", lambda m: _reais(m.group(1), "00"), texto)
    texto = re.sub(r"\b([01]?\d|2[0-3])(?::|h)([0-5]\d)\b", lambda m: _horas(m.group(1), m.group(2)), texto)
    texto = re.sub(r"\b([01]?\d|2[0-3])h\b", lambda m: _horas(m.group(1), "00"), texto)
    for sigla, extenso in (("GB", "gigabytes"), ("MB", "megabytes"), ("KB", "kilobytes"), ("TB", "terabytes"),
                           ("km/h", "quilômetros por hora"), ("mm", "milímetros")):
        texto = re.sub(rf"(\d)\s*{re.escape(sigla)}\b", rf"\1 {extenso}", texto)
    texto = texto.replace("&", " e ")
    return " ".join(texto.split())


def _reais(inteiro, centavos):
    reais = "1 real" if int(inteiro) == 1 else f"{int(inteiro)} reais"
    if int(centavos) == 0:
        return reais
    return f"{reais} e {int(centavos)} {'centavo' if int(centavos) == 1 else 'centavos'}"


def _horas(hora, minuto):
    hora = f"{int(hora)} {'hora' if int(hora) == 1 else 'horas'}"
    return hora if int(minuto) == 0 else f"{hora} e {int(minuto)}"


def pausa_depois(texto):
    """Silêncio depois de um trecho, pela pontuação do fim (o ritmo da fala)."""
    fim = texto.rstrip()[-1:] if texto.strip() else ""
    return PAUSAS.get(fim, PAUSA_SEM_PONTUACAO)


def criar_voz(nome):
    import sherpa_onnx
    pacote, falante, _descricao = VOZES[nome]
    pasta = pasta_do(pacote)
    if pacote == "kokoro":
        modelo = sherpa_onnx.OfflineTtsModelConfig(
            kokoro=sherpa_onnx.OfflineTtsKokoroModelConfig(
                model=str(pasta / ("model.int8.onnx" if kokoro_antigo() else "model.onnx")), voices=str(pasta / "voices.bin"),
                tokens=str(pasta / "tokens.txt"), data_dir=str(pasta / "espeak-ng-data"),
                lexicon=str(pasta / "lexicon-us-en.txt"), lang="pt-br"),
            num_threads=NUCLEOS_FALA)
    else:
        modelo = sherpa_onnx.OfflineTtsModelConfig(
            vits=sherpa_onnx.OfflineTtsVitsModelConfig(
                model=str(pasta / "pt_BR-faber-medium.onnx"), tokens=str(pasta / "tokens.txt"),
                data_dir=str(pasta / "espeak-ng-data")),
            num_threads=NUCLEOS_FALA)
    return sherpa_onnx.OfflineTts(sherpa_onnx.OfflineTtsConfig(model=modelo, max_num_sentences=1)), falante


def voz_disponivel(nome):
    """A voz pedida, ou outra que esteja instalada (ou "" se nenhuma)."""
    if nome in VOZES and instalado(VOZES[nome][0]):
        return nome
    return next((n for n, (pacote, _f, _d) in VOZES.items() if instalado(pacote)), "")


def para_pcm(audio, numpy):
    amostras = numpy.asarray(audio.samples, dtype=numpy.float32)
    pico = float(numpy.max(numpy.abs(amostras))) if len(amostras) else 0.0
    if pico > 0.98:                                    # evita estalos (a voz às vezes passa do limite)
        amostras = amostras * (0.95 / pico)
    return (numpy.clip(amostras, -1, 1) * 32767).astype(numpy.int16).tobytes()


class Falante:
    """A fala do modo servir: uma fila de trechos, sintetizados numa linha e tocados noutra (enquanto um trecho
    toca, o próximo já está sendo preparado). O tocador fica aberto entre os trechos e entre as falas (um fluxo
    só de áudio, sem o atraso de reabrir), e cada trecho termina com a pausa da sua pontuação. Calar para na hora."""

    def __init__(self):
        import numpy
        self.numpy = numpy
        self.vozes = {}                                  # nome → (modelo, falante)
        self.frases = queue.Queue()
        self.audio = queue.Queue(maxsize=8)
        self.geracao = 0                                 # muda ao calar: o que estava na fila é descartado
        self.processo = None
        self.taxa = 0
        self.tocando_ate = 0.0                           # quando termina de sair o som já entregue ao tocador
        self.ultimo_uso = time.monotonic()
        self.contas = {}                                 # id → {"frases", "inicio", "primeira", "concluida"}
        self._trava_tocador = threading.Lock()
        threading.Thread(target=self._sintetizar, daemon=True).start()
        threading.Thread(target=self._tocar, daemon=True).start()
        threading.Thread(target=self._fechar_ocioso, daemon=True).start()

    def falar(self, ident, texto, voz, velocidade):
        texto = preparar_texto(texto)
        if not texto:
            return
        conta = self.contas.setdefault(ident, {"frases": 0, "inicio": time.monotonic(), "primeira": None, "pendentes": 0,
                                               "concluida": False})
        conta["pendentes"] += 1
        self.frases.put((self.geracao, ident, texto, voz, velocidade))

    def concluir(self, ident):
        conta = self.contas.get(ident)
        if conta is None:
            dizer(evento="fim_fala", id=ident, frases=0)
            return
        conta["concluida"] = True
        self.frases.put((self.geracao, ident, None, "", 1.0))   # o fim passa pela mesma fila: chega depois do último trecho

    def calar(self):
        self.geracao += 1
        for fila in (self.frases, self.audio):
            while True:
                try:
                    fila.get_nowait()
                except queue.Empty:
                    break
        self._fechar_tocador(na_hora=True)
        for ident in list(self.contas):
            dizer(evento="fim_fala", id=ident, frases=self.contas[ident]["frases"], calada=True)
        self.contas.clear()

    def descarregar(self):
        self.vozes.clear()

    def _voz(self, nome):
        nome = voz_disponivel(nome)
        if not nome:
            raise RuntimeError("nenhuma voz instalada (Configurações › Wise › Voz)")
        if nome not in self.vozes:
            inicio = time.monotonic()
            self.vozes[nome] = criar_voz(nome)
            dizer(evento="voz_carregada", voz=nome, segundos=round(time.monotonic() - inicio, 2),
                  rapida=not (VOZES[nome][0] == "kokoro" and kokoro_antigo()))
        return self.vozes[nome]

    def _sintetizar(self):
        while True:
            geracao, ident, texto, nome, velocidade = self.frases.get()
            if geracao != self.geracao:
                continue
            if texto is None:
                self.audio.put((geracao, ident, None, 0, 0.0))
                continue
            try:
                modelo, falante = self._voz(nome)
                inicio = time.monotonic()
                audio = modelo.generate(texto, sid=falante, speed=velocidade)
                pcm = para_pcm(audio, self.numpy)
                if geracao != self.geracao:
                    continue
                self.ultimo_uso = time.monotonic()
                self.audio.put((geracao, ident, pcm, audio.sample_rate, pausa_depois(texto)))
                duracao = len(pcm) / 2 / audio.sample_rate
                dizer(evento="frase", id=ident, segundos=round(duracao, 2), sintese=round(time.monotonic() - inicio, 2),
                      rtf=round((time.monotonic() - inicio) / duracao, 2) if duracao else None)
            except Exception as erro:  # noqa: BLE001 — modelo corrompido, falta de memória…
                dizer(evento="erro", id=ident, mensagem=f"não consegui falar: {erro}"[:300])
                self.audio.put((geracao, ident, b"", 0, 0.0))

    def _abrir_tocador(self, taxa):
        if self.processo is not None and self.taxa == taxa and self.processo.poll() is None:
            return self.processo
        self._fechar_tocador()
        self.processo, self.taxa = tocador(taxa), taxa
        self.tocando_ate = time.monotonic()
        if self.processo is None:
            raise RuntimeError("sem programa para tocar o som (pipewire, pulseaudio-utils ou alsa-utils)")
        return self.processo

    def _fechar_tocador(self, na_hora=False):
        with self._trava_tocador:
            processo, self.processo = self.processo, None
        if processo is None:
            return
        try:
            if na_hora:
                processo.kill()
            else:
                processo.stdin.close()
                processo.wait(timeout=60)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            processo.kill()

    def _fechar_ocioso(self):
        while True:
            time.sleep(2)
            if self.processo is not None and self.frases.empty() and self.audio.empty() and not self.contas \
                    and time.monotonic() - max(self.tocando_ate, self.ultimo_uso) > TOCADOR_OCIOSO_S:
                self._fechar_tocador()

    def _tocar(self):
        while True:
            geracao, ident, pcm, taxa, pausa = self.audio.get()
            if geracao != self.geracao:
                continue
            conta = self.contas.get(ident)
            if pcm is None:
                # Fim da fala: o tocador continua aberto; o aviso sai quando o último som termina de tocar
                espera = self.tocando_ate - time.monotonic()
                if espera > 0:
                    time.sleep(min(espera, 120))
                if geracao == self.geracao and conta is not None:
                    dizer(evento="fim_fala", id=ident, frases=conta["frases"],
                          primeira_s=round(conta["primeira"], 2) if conta["primeira"] is not None else None)
                    self.contas.pop(ident, None)
                continue
            if not pcm:
                continue
            try:
                processo = self._abrir_tocador(taxa)
                if conta is not None:
                    conta["frases"] += 1
                    if conta["primeira"] is None:
                        conta["primeira"] = time.monotonic() - conta["inicio"]
                        dizer(evento="falando", id=ident, primeira_s=round(conta["primeira"], 2))
                silencio = b"\x00\x00" * int(taxa * pausa)
                agora = time.monotonic()
                self.tocando_ate = max(self.tocando_ate, agora) + (len(pcm) + len(silencio)) / 2 / taxa
                processo.stdin.write(pcm + silencio)
                processo.stdin.flush()
            except (BrokenPipeError, OSError, ValueError, RuntimeError) as erro:
                if geracao == self.geracao:
                    dizer(evento="erro", id=ident, mensagem=f"não consegui tocar o som: {erro}"[:300])
                self._fechar_tocador(na_hora=True)


def falar(argumentos):
    """Modo antigo (linha de comando): fala cada linha da entrada; com --arquivo, grava num WAV."""
    import numpy
    nome = voz_disponivel(opcao(argumentos, "--voz", "dora"))
    velocidade = min(1.5, max(0.7, float(opcao(argumentos, "--velocidade", "1.0"))))
    arquivo = opcao(argumentos, "--arquivo", "")
    if not nome:
        dizer(erro="nenhuma voz instalada (duiaos-voz baixar dora)")
        return 3
    try:
        voz, falante = criar_voz(nome)
    except Exception as erro:  # noqa: BLE001
        dizer(erro=f"não consegui carregar a voz: {erro}"[:300])
        return 1
    taxa = voz.sample_rate
    import wave
    saida_wav = processo = None
    if arquivo:
        saida_wav = wave.open(arquivo, "wb")
        saida_wav.setnchannels(1)
        saida_wav.setsampwidth(2)
        saida_wav.setframerate(taxa)
    else:
        processo = tocador(taxa)
        if processo is None:
            dizer(erro="sem programa para tocar o som (pipewire, pulseaudio-utils ou alsa-utils)")
            return 1
    parar = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: parar.set())
    dizer(pronto=True, voz=nome, taxa=taxa)
    numero = 0
    silencio = numpy.zeros(int(taxa * 0.16), dtype=numpy.int16).tobytes()
    try:
        for linha in sys.stdin:
            if parar.is_set():
                break
            texto = preparar_texto(linha)
            if not texto:
                continue
            numero += 1
            inicio = time.monotonic()
            pcm = para_pcm(voz.generate(texto, sid=falante, speed=velocidade), numpy)
            if parar.is_set():
                break
            if saida_wav is not None:
                saida_wav.writeframes(pcm + silencio)
            else:
                processo.stdin.write(pcm + silencio)
                processo.stdin.flush()
            dizer(frase=numero, segundos=round(len(pcm) / 2 / taxa, 2), sintese=round(time.monotonic() - inicio, 2))
    except (BrokenPipeError, OSError):
        pass
    finally:
        if saida_wav is not None:
            saida_wav.close()
        if processo is not None:
            try:
                if parar.is_set():
                    processo.kill()
                else:
                    processo.stdin.close()
                    processo.wait(timeout=120)
            except (OSError, subprocess.TimeoutExpired):
                processo.kill()
    dizer(fim=True, frases=numero)
    return 0


