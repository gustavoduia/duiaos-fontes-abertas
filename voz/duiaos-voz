def pasta_do(pacote):
    return PASTA / PACOTES[pacote].get("pasta", pacote)


def instalado(pacote):
    info = PACOTES[pacote]
    if pacote == "kokoro" and kokoro_antigo():
        return True
    return all((pasta_do(pacote) / nome).exists() for nome in info["manter"] if nome not in ("LICENSE", "MODEL_CARD"))


def kokoro_antigo():
    """Kokoro int8 baixado por versões antigas (mais lento): continua funcionando até a pessoa baixar o rápido."""
    pasta = pasta_do("kokoro")
    return not (pasta / "model.onnx").exists() and (pasta / "model.int8.onnx").exists() and (pasta / "voices.bin").exists()


def whisper_antigo():
    """Reconhecimento baixado por versões antigas (Whisper), usado só se o Parakeet não estiver aqui."""
    for pasta, prefixo in (("ouvir-preciso", "small"), ("ouvir", "base")):
        base = PASTA / pasta
        if (base / f"{prefixo}-encoder.int8.onnx").exists() and (base / f"{prefixo}-tokens.txt").exists():
            return base, prefixo
    return None


