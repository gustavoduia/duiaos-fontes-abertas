def tocador(taxa, so_conferir=False):
    """Processo que toca PCM de 16 bits, mono, vindo pela entrada (PipeWire, PulseAudio ou ALSA)."""
    candidatos = [["pw-cat", "--playback", "--raw", "--format", "s16", "--rate", str(taxa), "--channels", "1",
                   "--media-role", "Assistant", "--properties", "media.name=Wise", "-"],
                  ["paplay", "--raw", f"--rate={taxa}", "--format=s16le", "--channels=1", "--client-name=Wise",
                   "--latency-msec=120"],
                  ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(taxa), "-c", "1", "-"]]
    for comando in candidatos:
        if shutil.which(comando[0]):
            if so_conferir:
                return comando[0]
            return subprocess.Popen(comando, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    return None


def gravador(so_conferir=False):
    """Processo que escreve na saída o microfone em PCM de 16 bits, mono, 16 kHz."""
    candidatos = [["pw-cat", "--record", "--raw", "--format", "s16", "--rate", str(TAXA_MICROFONE), "--channels", "1",
                   "--media-role", "Communication", "--properties", "media.name=Wise", "-"],
                  ["parecord", "--raw", f"--rate={TAXA_MICROFONE}", "--format=s16le", "--channels=1", "--client-name=Wise"],
                  ["arecord", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(TAXA_MICROFONE), "-c", "1", "-"]]
    for comando in candidatos:
        if shutil.which(comando[0]):
            if so_conferir:
                return comando[0]
            return subprocess.Popen(comando, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return None


