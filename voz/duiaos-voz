NUCLEOS = max(1, min(4, (os.cpu_count() or 2) - 1))


def dizer(**dados):
    print(json.dumps(dados, ensure_ascii=False), flush=True)


def instalado(pacote):
    info = PACOTES[pacote]
    return all((PASTA / pacote / nome).exists() for nome in info["manter"] if nome not in ("LICENSE", "MODEL_CARD"))


# ------------------------------------------------------------------ estado, baixar, remover

def estado():
    try:
        import sherpa_onnx  # noqa: F401
        motor = True
    except ImportError:
        motor = False
    return {"motor": motor, "pasta": str(PASTA),
            "vozes": [{"id": nome, "nome": descricao, "pacote": pacote, "instalada": instalado(pacote),
                       "tamanho": PACOTES[pacote]["tamanho"]} for nome, (pacote, _n, descricao) in VOZES.items()],
            "pacotes": {nome: {"instalado": instalado(nome), "tamanho": info["tamanho"], "licenca": info["licenca"]}
                        for nome, info in PACOTES.items()},
            "ouvir": instalado("ouvir") or instalado("ouvir-preciso"),
            "tocar": bool(tocador(24000, so_conferir=True)), "gravar": bool(gravador(so_conferir=True))}


def _baixar_arquivo(url, destino, soma, ao_andar):
    destino.parent.mkdir(parents=True, exist_ok=True)
    parcial = destino.with_suffix(destino.suffix + ".parcial")
    resumo = hashlib.sha256()
    with urllib.request.urlopen(url, timeout=60) as resposta, open(parcial, "wb") as saida:
        total, feito, ultimo = int(resposta.headers.get("Content-Length") or 0), 0, 0.0
        while True:
            bloco = resposta.read(1 << 18)
            if not bloco:
                break
            saida.write(bloco)
            resumo.update(bloco)
            feito += len(bloco)
            if time.monotonic() - ultimo > 0.4:
                ultimo = time.monotonic()
                ao_andar(feito, total)
    if not soma.startswith("@") and resumo.hexdigest() != soma:
        parcial.unlink(missing_ok=True)
        raise RuntimeError("o arquivo baixado não confere (soma diferente); nada foi instalado")
    os.replace(parcial, destino)


def baixar(pacote):
    if pacote in VOZES:
        pacote = VOZES[pacote][0]
    if pacote not in PACOTES:
        dizer(erro=f"item desconhecido: {pacote}")
        return 2
    info = PACOTES[pacote]
    if instalado(pacote):
        dizer(fracao=1.0, pronto=True)
        return 0
    arquivo = PASTA / "baixando" / (pacote + ".tar.bz2")
    try:
        _baixar_arquivo(info["url"], arquivo, info["sha256"],
                        lambda feito, total: dizer(fracao=round(0.92 * feito / (total or info["tamanho"]), 3), baixado=feito,
                                                   total=total or info["tamanho"]))
        dizer(fracao=0.93, etapa="instalando")
        destino, temporario = PASTA / pacote, PASTA / "baixando" / pacote
        shutil.rmtree(temporario, ignore_errors=True)
        with tarfile.open(arquivo, "r:bz2") as tar:
            raiz = info["raiz"] + "/"
            membros = [m for m in tar.getmembers() if m.name.startswith(raiz)
                       and any(m.name[len(raiz):] == nome or m.name[len(raiz):].startswith(nome + "/") for nome in info["manter"])
                       and (m.isfile() or m.isdir()) and ".." not in m.name]
            tar.extractall(temporario, members=membros, filter="data")
        shutil.rmtree(destino, ignore_errors=True)
        os.replace(temporario / info["raiz"], destino)
        if pacote.startswith("ouvir") and not (PASTA / "silero_vad.onnx").exists():
            _baixar_arquivo(VAD["url"], PASTA / "silero_vad.onnx", VAD["sha256"], lambda *_: None)
    except (OSError, RuntimeError, tarfile.TarError) as erro:
        dizer(erro=str(erro)[:300])
        return 1
    finally:
        shutil.rmtree(PASTA / "baixando", ignore_errors=True)
    dizer(fracao=1.0, pronto=True)
    return 0


def remover(pacote):
    if pacote in VOZES:
        pacote = VOZES[pacote][0]
    if pacote in PACOTES:
        shutil.rmtree(PASTA / pacote, ignore_errors=True)
    dizer(pronto=True)
    return 0


# ------------------------------------------------------------------ som

def tocador(taxa, so_conferir=False):
    """Processo que toca PCM de 16 bits, mono, vindo pela entrada (PipeWire, PulseAudio ou ALSA)."""
    candidatos = [["pw-cat", "--playback", "--raw", "--format", "s16", "--rate", str(taxa), "--channels", "1",
                   "--media-role", "Communication", "-"],
                  ["paplay", "--raw", f"--rate={taxa}", "--format=s16le", "--channels=1", "--client-name=Wise"],
                  ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", str(taxa), "-c", "1", "-"]]
    for comando in candidatos:
        if shutil.which(comando[0]):
            if so_conferir:
                return comando[0]
            return subprocess.Popen(comando, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return None


def gravador(so_conferir=False):
    """Processo que escreve na saída o microfone em PCM de 16 bits, mono, 16 kHz."""
    candidatos = [["pw-cat", "--record", "--raw", "--format", "s16", "--rate", "16000", "--channels", "1",
                   "--media-role", "Communication", "-"],
                  ["parecord", "--raw", "--rate=16000", "--format=s16le", "--channels=1", "--client-name=Wise"],
                  ["arecord", "-q", "-t", "raw", "-f", "S16_LE", "-r", "16000", "-c", "1", "-"]]
    for comando in candidatos:
        if shutil.which(comando[0]):
            if so_conferir:
                return comando[0]
            return subprocess.Popen(comando, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return None


# ------------------------------------------------------------------ falar

def preparar_texto(texto):
    """Texto de conversa → texto para ser falado (sem marcações, endereços e símbolos soltos)."""
    import re
    texto = re.sub(r"```.*?```", " ", texto, flags=re.S)
    texto = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", texto)
    texto = re.sub(r"https?://\S+", " ", texto)
    texto = re.sub(r"(^|\n)\s*(#{1,6}|[-*+•]|\d+[.)])\s+", r"\1", texto)
    texto = re.sub(r"[*_`#>|~]+", "", texto)
    texto = texto.replace("%", " por cento").replace("&", " e ").replace("GB", " gigabytes").replace("MB", " megabytes")
    return " ".join(texto.split())


def criar_voz(nome):
    import sherpa_onnx
    pacote, falante, _descricao = VOZES[nome]
    pasta = PASTA / pacote
    if pacote == "kokoro":
        modelo = sherpa_onnx.OfflineTtsModelConfig(
            kokoro=sherpa_onnx.OfflineTtsKokoroModelConfig(
                model=str(pasta / "model.int8.onnx"), voices=str(pasta / "voices.bin"), tokens=str(pasta / "tokens.txt"),
                data_dir=str(pasta / "espeak-ng-data"), lexicon=str(pasta / "lexicon-us-en.txt"), lang="pt-br"),
            num_threads=NUCLEOS)
    else:
        modelo = sherpa_onnx.OfflineTtsModelConfig(
            vits=sherpa_onnx.OfflineTtsVitsModelConfig(
                model=str(pasta / "pt_BR-faber-medium.onnx"), tokens=str(pasta / "tokens.txt"),
                data_dir=str(pasta / "espeak-ng-data")),
            num_threads=NUCLEOS)
    return sherpa_onnx.OfflineTts(sherpa_onnx.OfflineTtsConfig(model=modelo, max_num_sentences=1)), falante


def falar(argumentos):
    import numpy
    nome = opcao(argumentos, "--voz", "dora")
    velocidade = min(1.5, max(0.7, float(opcao(argumentos, "--velocidade", "1.0"))))
    arquivo = opcao(argumentos, "--arquivo", "")
    if nome not in VOZES:
        nome = "dora"
    if not instalado(VOZES[nome][0]):
        # A voz pedida não está aqui: usa outra que esteja
        nome = next((n for n, (pacote, _f, _d) in VOZES.items() if instalado(pacote)), "")
        if not nome:
            dizer(erro="nenhuma voz instalada (duiaos-voz baixar dora)")
            return 3
    try:
        voz, falante = criar_voz(nome)
    except Exception as erro:  # noqa: BLE001 — modelo corrompido, falta de memória…
        dizer(erro=f"não consegui carregar a voz: {erro}"[:300])
        return 1
    taxa = voz.sample_rate
    saida_wav = None
    processo = None
    if arquivo:
        import wave
        saida_wav = wave.open(arquivo, "wb")
        saida_wav.setnchannels(1)
        saida_wav.setsampwidth(2)
        saida_wav.setframerate(taxa)
    else:
        processo = tocador(taxa)
        if processo is None:
            dizer(erro="sem programa para tocar o som (pipewire, pulseaudio-utils ou alsa-utils)")
            return 1
    parar = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: parar.set())
    dizer(pronto=True, voz=nome, taxa=taxa)
    numero = 0
    silencio = numpy.zeros(int(taxa * 0.18), dtype=numpy.int16).tobytes()      # respiro entre as frases
    try:
        for linha in sys.stdin:
            if parar.is_set():
                break
            texto = preparar_texto(linha)
            if not texto:
                continue
            numero += 1
            inicio = time.monotonic()
            audio = voz.generate(texto, sid=falante, speed=velocidade)
            amostras = (numpy.clip(numpy.asarray(audio.samples, dtype=numpy.float32), -1, 1) * 32767).astype(numpy.int16)
            if parar.is_set():
                break
            dados = amostras.tobytes() + silencio
            if saida_wav is not None:
                saida_wav.writeframes(dados)
            else:
                processo.stdin.write(dados)
                processo.stdin.flush()
            dizer(frase=numero, segundos=round(len(amostras) / taxa, 2), sintese=round(time.monotonic() - inicio, 2))
    except (BrokenPipeError, OSError):
        pass
    finally:
        if saida_wav is not None:
            saida_wav.close()
        if processo is not None:
            try:
                if parar.is_set():
                    processo.kill()                 # mandaram calar: para na hora
                else:
                    processo.stdin.close()
                    processo.wait(timeout=120)      # deixa terminar de tocar
            except (OSError, subprocess.TimeoutExpired):
                processo.kill()
    dizer(fim=True, frases=numero)
    return 0


# ------------------------------------------------------------------ ouvir

def ouvir(argumentos):
    import numpy
    import sherpa_onnx
    limite = min(120.0, max(3.0, float(opcao(argumentos, "--segundos", "30"))))
    arquivo = opcao(argumentos, "--arquivo", "")
    pacote = "ouvir-preciso" if ("--preciso" in argumentos or not instalado("ouvir")) and instalado("ouvir-preciso") else "ouvir"
    if not instalado(pacote):
        dizer(erro="o reconhecimento de fala não está instalado (duiaos-voz baixar ouvir)")
        return 3
    prefixo = "small" if pacote == "ouvir-preciso" else "base"
    pasta = PASTA / pacote
    idioma = (os.environ.get("LANG") or "pt_BR")[:2].lower()
    reconhecedor = sherpa_onnx.OfflineRecognizer.from_whisper(
        encoder=str(pasta / f"{prefixo}-encoder.int8.onnx"), decoder=str(pasta / f"{prefixo}-decoder.int8.onnx"),
        tokens=str(pasta / f"{prefixo}-tokens.txt"), language=idioma if len(idioma) == 2 else "pt", task="transcribe",
        num_threads=NUCLEOS)
    config = sherpa_onnx.VadModelConfig()
    config.silero_vad.model = str(PASTA / "silero_vad.onnx")
    config.silero_vad.min_silence_duration = 0.25
    config.sample_rate = 16000
    vad = sherpa_onnx.VoiceActivityDetector(config, buffer_size_in_seconds=limite + 5)
    janela = config.silero_vad.window_size

    parar = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: parar.set())
    if arquivo:
        import wave
        with wave.open(arquivo) as w:
            bruto = w.readframes(w.getnframes())
            taxa = w.getframerate()
        amostras = numpy.frombuffer(bruto, dtype=numpy.int16).astype(numpy.float32) / 32768
        if taxa != 16000:                            # reamostragem simples (só para os testes)
            posicoes = numpy.linspace(0, len(amostras) - 1, int(len(amostras) * 16000 / taxa))
            amostras = numpy.interp(posicoes, numpy.arange(len(amostras)), amostras).astype(numpy.float32)
        blocos = (amostras[i:i + 1600] for i in range(0, len(amostras), 1600))
        processo = None
    else:
        processo = gravador()
        if processo is None:
            dizer(erro="sem programa para gravar o microfone (pipewire, pulseaudio-utils ou alsa-utils)")
            return 1

        def do_microfone():
            while not parar.is_set():
                dados = processo.stdout.read(3200)          # 0,1 s
                if not dados:
                    return
                yield numpy.frombuffer(dados[:len(dados) // 2 * 2], dtype=numpy.int16).astype(numpy.float32) / 32768
        blocos = do_microfone()
    dizer(ouvindo=True)
    falas, resto = [], numpy.zeros(0, dtype=numpy.float32)
    inicio, ultima_fala, falou, total = time.monotonic(), None, False, 0.0
    try:
        for bloco in blocos:
            total += len(bloco) / 16000
            resto = numpy.concatenate([resto, bloco])
            while len(resto) >= janela:
                vad.accept_waveform(resto[:janela])
                resto = resto[janela:]
            agora = total if arquivo else time.monotonic() - inicio
            if vad.is_speech_detected():
                falou, ultima_fala = True, agora
            while not vad.empty():
                falas.append(numpy.array(vad.front.samples, dtype=numpy.float32))
                vad.pop()
            dizer(nivel=round(float(min(1.0, numpy.sqrt(numpy.mean(bloco ** 2)) * 6)), 2), falando=bool(vad.is_speech_detected()))
            # Termina 1,3 s depois de a pessoa parar de falar; sem fala nenhuma, depois de 8 s; ou no limite
            if (falou and ultima_fala is not None and agora - ultima_fala > 1.3) or (not falou and agora > 8) or agora > limite:
                break
    finally:
        if processo is not None:
            processo.kill()
    vad.flush()
    while not vad.empty():
        falas.append(numpy.array(vad.front.samples, dtype=numpy.float32))
        vad.pop()
    if not falas:
        dizer(texto="", fim=True)
        return 0
    dizer(transcrevendo=True)
    audio = numpy.concatenate(falas)
    partes = []
    for comeco in range(0, len(audio), 28 * 16000):          # o Whisper lê até 30 s por vez
        fluxo = reconhecedor.create_stream()
        fluxo.accept_waveform(16000, audio[comeco:comeco + 28 * 16000])
        reconhecedor.decode_stream(fluxo)
        partes.append(fluxo.result.text.strip())
    dizer(texto=" ".join(p for p in partes if p), fim=True, segundos=round(len(audio) / 16000, 1))
    return 0


def opcao(argumentos, nome, padrao):
    return argumentos[argumentos.index(nome) + 1] if nome in argumentos and argumentos.index(nome) + 1 < len(argumentos) else padrao


def main(argumentos):
    comando = argumentos[0] if argumentos else ""
    if comando == "estado":
        dizer(**estado())
        return 0
    if comando in ("baixar", "remover") and len(argumentos) > 1:
        return (baixar if comando == "baixar" else remover)(argumentos[1])
    if comando == "falar":
        return falar(argumentos[1:])
    if comando == "ouvir":
        return ouvir(argumentos[1:])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
