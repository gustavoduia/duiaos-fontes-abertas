def limpar_texto(texto, motor):
    texto = " ".join(str(texto or "").split())
    if motor == "whisper" and ALUCINACOES.search(texto):
        return ""
    if texto and texto[0].islower():
        texto = texto[0].upper() + texto[1:]
    return texto


def db(valor):
    import math
    return round(20 * math.log10(max(valor, 1e-6)), 1)


class Ouvido:
    """Reconhecimento de fala: o modelo fica carregado entre um pedido e outro."""

    def __init__(self):
        self.reconhecedor = None
        self.motor = ""
        self.ultimo_uso = time.monotonic()

    def carregar(self):
        import sherpa_onnx
        if self.reconhecedor is not None:
            return
        inicio = time.monotonic()
        if instalado("ouvir"):
            pasta = pasta_do("ouvir")
            self.reconhecedor = sherpa_onnx.OfflineRecognizer.from_transducer(
                encoder=str(pasta / "encoder.int8.onnx"), decoder=str(pasta / "decoder.int8.onnx"),
                joiner=str(pasta / "joiner.int8.onnx"), tokens=str(pasta / "tokens.txt"),
                model_type="nemo_transducer", num_threads=NUCLEOS)
            self.motor = "parakeet"
        else:
            antigo = whisper_antigo()
            if not antigo:
                raise RuntimeError("o reconhecimento de fala não está instalado (Configurações › Wise › Voz)")
            pasta, prefixo = antigo
            idioma = (os.environ.get("LANG") or "pt_BR")[:2].lower()
            self.reconhecedor = sherpa_onnx.OfflineRecognizer.from_whisper(
                encoder=str(pasta / f"{prefixo}-encoder.int8.onnx"), decoder=str(pasta / f"{prefixo}-decoder.int8.onnx"),
                tokens=str(pasta / f"{prefixo}-tokens.txt"), language=idioma if len(idioma) == 2 else "pt",
                task="transcribe", num_threads=NUCLEOS)
            self.motor = "whisper"
        dizer(evento="reconhecimento_carregado", motor=self.motor, segundos=round(time.monotonic() - inicio, 2))

    def descarregar(self):
        self.reconhecedor = None

    def transcrever(self, audio, numpy):
        """Áudio (float32, 16 kHz) → texto. Normaliza o volume antes (microfone baixo)."""
        self.carregar()
        self.ultimo_uso = time.monotonic()
        audio = audio - float(numpy.mean(audio)) if len(audio) else audio
        pico = float(numpy.max(numpy.abs(audio))) if len(audio) else 0.0
        if 0 < pico < 0.5:
            audio = audio * min(20.0, 0.7 / pico)
        partes = []
        passo = 28 * TAXA_MICROFONE                           # o Whisper lê até 30 s por vez; o Parakeet aguenta mais
        for comeco in range(0, len(audio), passo):
            fluxo = self.reconhecedor.create_stream()
            fluxo.accept_waveform(TAXA_MICROFONE, audio[comeco:comeco + passo].astype(numpy.float32))
            self.reconhecedor.decode_stream(fluxo)
            partes.append(fluxo.result.text.strip())
        return limpar_texto(" ".join(p for p in partes if p), self.motor)


def _recortar(tudo, trechos, numpy):
    """Só a fala do áudio ouvido, com uma folga antes e depois de cada trecho (o detector corta o comecinho)."""
    audio = numpy.concatenate(tudo) if tudo else numpy.zeros(0, dtype=numpy.float32)
    folga = int(0.3 * TAXA_MICROFONE)
    if not trechos:
        return audio[:0]
    return numpy.concatenate([audio[max(0, a - folga):min(len(audio), b + folga)] for a, b in trechos])


def termina_em_continuacao(texto):
    """A pessoa parou numa palavra que pede continuação ("Abre o VLC e…"): ainda não é a vez do Wise."""
    palavras = re.findall(r"[\wÀ-ÿ]+", texto.lower())
    # O Parakeet pontua tudo ("Abre o VLC e."): o ponto final não conta; pergunta e exclamação encerram
    return bool(palavras) and palavras[-1] in CONTINUACAO and not re.search(r"[!?]\s*$", texto)


def escutar(blocos, vad_modelo, limite, parar, numpy, ao_evento, eh_arquivo=False, ao_pausa=None):
    """Lê o microfone (ou um arquivo) em blocos e devolve (áudio só com a fala, estatísticas).
    Usa o detector de fala (Silero) e guarda o áudio inteiro, para recortar cada fala com uma folga antes e
    depois (o detector corta o comecinho das palavras). Fim da vez da pessoa: SILENCIO_FIM_S depois da fala;
    ao_pausa(fala até agora) pode pedir para esperar mais (até SILENCIO_CONTINUACAO_S)."""
    import sherpa_onnx
    config = sherpa_onnx.VadModelConfig()
    config.silero_vad.model = str(vad_modelo)
    config.silero_vad.threshold = 0.45
    config.silero_vad.min_silence_duration = 0.5
    config.silero_vad.min_speech_duration = 0.2
    config.sample_rate = TAXA_MICROFONE
    vad = sherpa_onnx.VoiceActivityDetector(config, buffer_size_in_seconds=limite + 5)
    janela = config.silero_vad.window_size
    tudo, resto, trechos = [], numpy.zeros(0, dtype=numpy.float32), []
    total, falou, ultima_fala, soma_quadrados, pico, amostras = 0.0, False, None, 0.0, 0.0, 0
    pausa_avaliada = None                             # a última pausa já avaliada (não avalia a mesma duas vezes)
    picos_recentes = []                               # ganho automático: microfones embutidos costumam ser baixos
    inicio = time.monotonic()
    for bloco in blocos:
        if parar.is_set():
            break
        bloco = bloco - float(numpy.mean(bloco)) if len(bloco) else bloco
        picos_recentes = (picos_recentes + [float(numpy.max(numpy.abs(bloco))) if len(bloco) else 0.0])[-15:]
        ganho = min(30.0, max(1.0, 0.35 / max(max(picos_recentes), 1e-4)))
        bloco = numpy.clip(bloco * ganho, -1.0, 1.0).astype(numpy.float32)
        tudo.append(bloco)
        amostras += len(bloco)
        total += len(bloco) / TAXA_MICROFONE
        soma_quadrados += float(numpy.sum((bloco / ganho) ** 2))     # o nível de verdade (antes do ganho)
        pico = max(pico, picos_recentes[-1])
        resto = numpy.concatenate([resto, bloco])
        while len(resto) >= janela:
            vad.accept_waveform(resto[:janela])
            resto = resto[janela:]
        agora = total if eh_arquivo else time.monotonic() - inicio
        if vad.is_speech_detected():
            falou, ultima_fala = True, agora
        while not vad.empty():
            trechos.append((vad.front.start, vad.front.start + len(vad.front.samples)))
            vad.pop()
        rms = float(numpy.sqrt(numpy.mean(bloco ** 2))) if len(bloco) else 0.0
        ao_evento(nivel=round(min(1.0, rms * 4), 2), falando=bool(vad.is_speech_detected()))
        # Termina SILENCIO_FIM_S depois de a pessoa parar de falar (ou mais, se ela parou no meio da ideia);
        # sem fala nenhuma, depois de 7 s; ou no limite
        if falou and ultima_fala is not None:
            silencio = agora - ultima_fala
            if silencio > SILENCIO_CONTINUACAO_S:
                break
            if silencio > SILENCIO_FIM_S and pausa_avaliada != ultima_fala:
                pausa_avaliada = ultima_fala
                while not vad.empty():
                    trechos.append((vad.front.start, vad.front.start + len(vad.front.samples)))
                    vad.pop()
                if ao_pausa is None or ao_pausa(_recortar(tudo, trechos, numpy)):
                    break
        if (not falou and agora > 7) or agora > limite:
            break
    vad.flush()
    while not vad.empty():
        trechos.append((vad.front.start, vad.front.start + len(vad.front.samples)))
        vad.pop()
    fala = _recortar(tudo, trechos, numpy)
    media = (soma_quadrados / amostras) ** 0.5 if amostras else 0.0
    return fala, {"ouvido_s": round(total, 1), "fala_s": round(len(fala) / TAXA_MICROFONE, 1),
                  "nivel_medio_db": db(media), "pico_db": db(pico), "mudo": pico == 0.0}


def blocos_do_arquivo(arquivo, numpy):
    import wave
    with wave.open(arquivo) as w:
        bruto, taxa = w.readframes(w.getnframes()), w.getframerate()
    amostras = numpy.frombuffer(bruto, dtype=numpy.int16).astype(numpy.float32) / 32768
    if taxa != TAXA_MICROFONE:
        posicoes = numpy.linspace(0, len(amostras) - 1, int(len(amostras) * TAXA_MICROFONE / taxa))
        amostras = numpy.interp(posicoes, numpy.arange(len(amostras)), amostras).astype(numpy.float32)
    return (amostras[i:i + 1600] for i in range(0, len(amostras), 1600))


def blocos_do_microfone(processo, parar, numpy):
    while not parar.is_set():
        dados = processo.stdout.read(3200)          # 0,1 s
        if not dados:
            return
        yield numpy.frombuffer(dados[:len(dados) // 2 * 2], dtype=numpy.int16).astype(numpy.float32) / 32768


def explicar_silencio(estatisticas):
    """Por que não houve texto, em português, para a pessoa."""
    if estatisticas.get("mudo"):
        return "O microfone não mandou nenhum som. Confira se há um microfone ligado em Configurações › Som."
    if estatisticas.get("pico_db", -99) < -45:
        return "O som do microfone está muito baixo. Aumente o volume de entrada em Configurações › Som ou fale mais perto."
    return "Não entendi o que foi dito. Tente de novo, falando um pouco mais devagar."


def ouvir_uma_vez(ouvido, argumentos_ou_pedido, ao_evento, parar):
    """Ouve (microfone ou arquivo) e devolve o evento final com o texto."""
    import numpy
    limite = min(120.0, max(3.0, float(argumentos_ou_pedido.get("segundos", 30))))
    arquivo = argumentos_ou_pedido.get("arquivo", "")
    if not (PASTA / "silero_vad.onnx").exists():
        return {"erro": "o reconhecimento de fala não está instalado (Configurações › Wise › Voz)"}
    try:
        ouvido.carregar()                            # antes de abrir o microfone: o primeiro pedido não perde fala
    except Exception as erro:  # noqa: BLE001
        return {"erro": str(erro)[:300]}
    processo = None
    if arquivo:
        blocos = blocos_do_arquivo(arquivo, numpy)
    else:
        processo = gravador()
        if processo is None:
            return {"erro": "sem programa para gravar o microfone (pipewire, pulseaudio-utils ou alsa-utils)"}
        blocos = blocos_do_microfone(processo, parar, numpy)
    ao_evento(ouvindo=True)
    previa = {"amostras": -1, "texto": "", "segundos": 0.0}

    def ao_pausa(fala_ate_agora):
        """Na pausa: transcreve o que já foi dito (rápido no Parakeet). Se terminou numa palavra que pede
        continuação, espera; senão, é o fim — e o texto já está pronto."""
        if len(fala_ate_agora) < int(0.25 * TAXA_MICROFONE):
            return True
        inicio = time.monotonic()
        try:
            texto = ouvido.transcrever(fala_ate_agora, numpy)
        except Exception:  # noqa: BLE001 — a transcrição final tenta de novo
            return True
        previa.update(amostras=len(fala_ate_agora), texto=texto, segundos=time.monotonic() - inicio)
        return not termina_em_continuacao(texto)
    try:
        fala, estatisticas = escutar(blocos, PASTA / "silero_vad.onnx", limite, parar, numpy, ao_evento,
                                     eh_arquivo=bool(arquivo), ao_pausa=None if argumentos_ou_pedido.get("sem_pausa") else ao_pausa)
    finally:
        if processo is not None:
            processo.kill()
    if argumentos_ou_pedido.get("cancelado"):
        return {"texto": "", "cancelado": True, **estatisticas}
    if len(fala) < int(0.25 * TAXA_MICROFONE):
        return {"texto": "", "motivo": explicar_silencio(estatisticas), **estatisticas}
    ao_evento(transcrevendo=True)
    inicio = time.monotonic()
    if previa["amostras"] == len(fala):
        texto = previa["texto"]                     # já transcrito na pausa: o pedido sai na hora
        transcricao_s = 0.0
    else:
        try:
            texto = ouvido.transcrever(fala, numpy)
        except Exception as erro:  # noqa: BLE001
            return {"erro": f"o reconhecimento falhou: {erro}"[:300], **estatisticas}
        transcricao_s = round(time.monotonic() - inicio, 2)
    final = {"texto": texto, "motor": ouvido.motor, "transcricao_s": transcricao_s,
             "previa_s": round(previa["segundos"], 2), **estatisticas}
    if not texto:
        final["motivo"] = explicar_silencio(estatisticas)
    return final


def ouvir(argumentos):
    """Modo antigo (linha de comando)."""
    parar = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: parar.set())
    pedido = {"segundos": opcao(argumentos, "--segundos", "30"), "arquivo": opcao(argumentos, "--arquivo", "")}
    final = ouvir_uma_vez(Ouvido(), pedido, lambda **dados: dizer(**dados), parar)
    dizer(fim=True, **final)
    return 0 if "erro" not in final else 1


