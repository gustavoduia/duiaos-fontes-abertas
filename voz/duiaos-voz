def _baixar_arquivo(url, destino, soma, ao_andar):
    destino.parent.mkdir(parents=True, exist_ok=True)
    parcial = destino.with_suffix(destino.suffix + ".parcial")
    resumo = hashlib.sha256()
    with urllib.request.urlopen(url, timeout=60) as resposta, open(parcial, "wb") as saida:
        total, feito, ultimo = int(resposta.headers.get("Content-Length") or 0), 0, 0.0
        while True:
            bloco = resposta.read(1 << 18)
            if not bloco:
                break
            saida.write(bloco)
            resumo.update(bloco)
            feito += len(bloco)
            if time.monotonic() - ultimo > 0.4:
                ultimo = time.monotonic()
                ao_andar(feito, total)
    if resumo.hexdigest() != soma:
        parcial.unlink(missing_ok=True)
        raise RuntimeError("o arquivo baixado não confere (soma diferente); nada foi instalado")
    os.replace(parcial, destino)


def baixar(pacote):
    if pacote in VOZES:
        pacote = VOZES[pacote][0]
    if pacote == "ouvir-preciso":                 # nome antigo
        pacote = "ouvir"
    if pacote not in PACOTES:
        dizer(erro=f"item desconhecido: {pacote}")
        return 2
    info = PACOTES[pacote]
    if instalado(pacote) and not (pacote == "kokoro" and kokoro_antigo()):     # o Kokoro antigo é trocado pelo rápido
        dizer(fracao=1.0, pronto=True)
        return 0
    arquivo = PASTA / "baixando" / (pacote + ".tar.bz2")
    try:
        _baixar_arquivo(info["url"], arquivo, info["sha256"],
                        lambda feito, total: dizer(fracao=round(0.92 * feito / (total or info["tamanho"]), 3), baixado=feito,
                                                   total=total or info["tamanho"]))
        dizer(fracao=0.93, etapa="instalando")
        destino, temporario = pasta_do(pacote), PASTA / "baixando" / pacote
        shutil.rmtree(temporario, ignore_errors=True)
        with tarfile.open(arquivo, "r:bz2") as tar:
            raiz = info["raiz"] + "/"
            membros = [m for m in tar.getmembers() if m.name.startswith(raiz)
                       and any(m.name[len(raiz):] == nome or m.name[len(raiz):].startswith(nome + "/") for nome in info["manter"])
                       and (m.isfile() or m.isdir()) and ".." not in m.name]
            tar.extractall(temporario, members=membros, filter="data")
        shutil.rmtree(destino, ignore_errors=True)
        os.replace(temporario / info["raiz"], destino)
        if pacote == "ouvir":
            if not (PASTA / "silero_vad.onnx").exists():
                _baixar_arquivo(VAD["url"], PASTA / "silero_vad.onnx", VAD["sha256"], lambda *_: None)
            # O Whisper das versões antigas não é mais usado: libera o espaço
            for antiga in ("ouvir-preciso",):
                shutil.rmtree(PASTA / antiga, ignore_errors=True)
            for sobra in (PASTA / "ouvir").glob("*-*.onnx") if (PASTA / "ouvir").is_dir() else []:
                sobra.unlink(missing_ok=True)
    except (OSError, RuntimeError, tarfile.TarError) as erro:
        dizer(erro=str(erro)[:300])
        return 1
    finally:
        shutil.rmtree(PASTA / "baixando", ignore_errors=True)
    dizer(fracao=1.0, pronto=True)
    return 0


def remover(pacote):
    if pacote in VOZES:
        pacote = VOZES[pacote][0]
    if pacote in PACOTES:
        shutil.rmtree(pasta_do(pacote), ignore_errors=True)
    if pacote == "ouvir":
        shutil.rmtree(PASTA / "ouvir-preciso", ignore_errors=True)
    dizer(pronto=True)
    return 0


