def servir():
    """Modo servidor: lê pedidos JSON da entrada até ela fechar. Fala e escuta rodam em linhas próprias."""
    try:
        import numpy  # noqa: F401
        import sherpa_onnx  # noqa: F401
    except ImportError as erro:
        dizer(evento="erro", mensagem=f"o motor de voz não está instalado: {erro}")
        return 1
    falante, ouvido = Falante(), Ouvido()
    escuta = {"linha": None, "parar": threading.Event(), "pedido": {}}

    def vigiar_ociosidade():
        while True:
            time.sleep(30)
            agora = time.monotonic()
            if falante.vozes and agora - falante.ultimo_uso > OCIOSO_S and falante.frases.empty():
                falante.descarregar()
                dizer(evento="descarregado", parte="fala")
            if ouvido.reconhecedor is not None and agora - ouvido.ultimo_uso > OCIOSO_S and escuta["linha"] is None:
                ouvido.descarregar()
                dizer(evento="descarregado", parte="escuta")
    threading.Thread(target=vigiar_ociosidade, daemon=True).start()

    def escutar_em_linha(ident, pedido):
        def ao_evento(**dados):
            if "nivel" in dados:
                dizer(evento="nivel", id=ident, **dados)
            elif dados.get("ouvindo"):
                dizer(evento="ouvindo", id=ident)
            elif dados.get("transcrevendo"):
                dizer(evento="transcrevendo", id=ident)
        final = ouvir_uma_vez(ouvido, pedido, ao_evento, escuta["parar"])
        escuta["linha"] = None
        if "erro" in final:
            dizer(evento="erro", id=ident, mensagem=final.pop("erro"), **final)
        else:
            dizer(evento="texto", id=ident, **final)

    dizer(evento="pronto", nucleos=NUCLEOS, **{k: v for k, v in estado().items() if k in ("ouvir", "reconhecimento")})
    for linha in sys.stdin:
        try:
            pedido = json.loads(linha)
        except ValueError:
            continue
        if not isinstance(pedido, dict):
            continue
        cmd, ident = pedido.get("cmd"), str(pedido.get("id") or "")
        if cmd == "falar":
            velocidade = min(1.5, max(0.7, float(pedido.get("velocidade") or 1.0)))
            falante.falar(ident, str(pedido.get("texto") or ""), str(pedido.get("voz") or "dora"), velocidade)
        elif cmd == "concluir":
            falante.concluir(ident)
        elif cmd == "calar":
            falante.calar()
        elif cmd == "ouvir":
            if escuta["linha"] is not None:
                dizer(evento="erro", id=ident, mensagem="já estou ouvindo")
                continue
            falante.calar()                              # o Wise não fala por cima da pessoa
            escuta["parar"] = threading.Event()
            escuta["pedido"] = dict(pedido)
            escuta["linha"] = threading.Thread(target=escutar_em_linha, args=(ident, escuta["pedido"]), daemon=True)
            escuta["linha"].start()
        elif cmd in ("parar_ouvir", "cancelar_ouvir"):
            if cmd == "cancelar_ouvir" and escuta["linha"] is not None:
                escuta["pedido"]["cancelado"] = True
            escuta["parar"].set()
        elif cmd == "preparar":
            def preparar(voz=str(pedido.get("voz") or "dora"), escuta_tambem=bool(pedido.get("ouvir"))):
                try:
                    if voz_disponivel(voz):
                        falante._voz(voz)
                        falante.ultimo_uso = time.monotonic()
                    if escuta_tambem and (instalado("ouvir") or whisper_antigo()):
                        ouvido.carregar()
                        ouvido.ultimo_uso = time.monotonic()
                except Exception as erro:  # noqa: BLE001
                    dizer(evento="erro", mensagem=f"não consegui preparar a voz: {erro}"[:300])
            threading.Thread(target=preparar, daemon=True).start()
        elif cmd == "descarregar":
            falante.descarregar()
            ouvido.descarregar()
        elif cmd == "estado":
            dizer(evento="estado", **estado())
    falante.calar()
    escuta["parar"].set()
    return 0


def opcao(argumentos, nome, padrao):
    return argumentos[argumentos.index(nome) + 1] if nome in argumentos and argumentos.index(nome) + 1 < len(argumentos) else padrao


def main(argumentos):
    comando = argumentos[0] if argumentos else ""
    if comando == "servir":
        return servir()
    if comando == "estado":
        dizer(**estado())
        return 0
    if comando in ("baixar", "remover") and len(argumentos) > 1:
        return (baixar if comando == "baixar" else remover)(argumentos[1])
    if comando == "falar":
        return falar(argumentos[1:])
    if comando == "ouvir":
        return ouvir(argumentos[1:])
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
