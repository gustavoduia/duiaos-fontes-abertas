/* DuiaOS — estilo das partes do instalador feitas em widgets (a página do disco, as perguntas e a barra
   de andamento da instalação), com as cores e os cantos do estilo Futurista, modo claro.
   As outras páginas são QML (branding/duiaos/*.qml) e usam as mesmas cores (Estilo.qml). */

* { font-family: "Inter", "Noto Sans", sans-serif; font-size: 11pt; color: #0E1430; }
#mainApp, QWidget#mainApp, QStackedWidget { background-color: #F2F4FC; }
QLabel { background: transparent; }
QScrollArea, QAbstractScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* Botões (perguntas, "Voltar"/"Continuar" de diálogos, botões da página do disco) */
QPushButton { background-color: #FFFFFF; border: 1px solid #BFC8EA; border-radius: 19px; padding: 9px 22px; min-height: 20px; font-weight: 600; }
QPushButton:hover { background-color: #EEF1FD; border-color: #9FAAD9; }
QPushButton:pressed { background-color: #E2E7F8; }
QPushButton:disabled { color: #8C95B5; background-color: #EDF0FA; border-color: #DADFF2; }
QPushButton:default {
    color: #FFFFFF; border: none;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #06B6D4, stop:0.55 #3D5BFF, stop:1 #7C3AED); }
QPushButton:default:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0BC4E2, stop:0.55 #4A66FF, stop:1 #8A4BF2); }
QToolButton { background: transparent; border: none; border-radius: 10px; padding: 6px; }
QToolButton:hover { background-color: #E7ECFF; }

/* Campos e listas */
QLineEdit, QComboBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF; border: 1px solid #BFC8EA; border-radius: 12px; padding: 8px 12px; min-height: 22px;
    selection-background-color: #3D5BFF; selection-color: #FFFFFF; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #3D5BFF; }
QComboBox::drop-down { border: none; width: 30px; }
QComboBox QAbstractItemView { background: #FFFFFF; border: 1px solid #DADFF2; border-radius: 10px; padding: 4px;
    selection-background-color: #E7ECFF; selection-color: #0E1430; outline: none; }
QListView, QListWidget, QTreeView, QTableView {
    background-color: #FFFFFF; border: 1px solid #DADFF2; border-radius: 14px; padding: 4px;
    alternate-background-color: #F7F8FE; selection-background-color: #3D5BFF; selection-color: #FFFFFF; outline: none; }
QTreeView::item, QListView::item { padding: 6px 4px; border-radius: 8px; }
QHeaderView::section { background-color: #F2F4FC; color: #56608A; border: none; border-bottom: 1px solid #DADFF2; padding: 8px 10px; font-weight: 600; }

/* Escolhas (Apagar o disco, Instalar ao lado, Substituir, Manual) e caixas de marcar */
QRadioButton, QCheckBox { spacing: 10px; background: transparent; }
QRadioButton::indicator { width: 22px; height: 22px; image: url(/etc/calamares/branding/duiaos/simbolos/radio.svg); }
QRadioButton::indicator:checked { image: url(/etc/calamares/branding/duiaos/simbolos/radio-marcado.svg); }
QCheckBox::indicator { width: 22px; height: 22px; image: url(/etc/calamares/branding/duiaos/simbolos/caixa.svg); }
QCheckBox::indicator:checked { image: url(/etc/calamares/branding/duiaos/simbolos/caixa-marcada.svg); }

QGroupBox { border: 1px solid #DADFF2; border-radius: 18px; margin-top: 16px; padding: 14px; background-color: #FFFFFF; }
QGroupBox::title { subcontrol-origin: margin; left: 16px; padding: 0 6px; color: #16205C; font-weight: 700; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #DADFF2; background: #DADFF2; max-height: 1px; border: none; }

/* Andamento da instalação (embaixo da tela "Instalando o DuiaOS") */
QProgressBar { border: none; border-radius: 4px; background-color: #DADFF2; max-height: 8px; min-height: 8px; text-align: center; color: transparent; margin: 0 40px; }
QProgressBar::chunk { border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #06B6D4, stop:0.55 #3D5BFF, stop:1 #7C3AED); }

/* Perguntas (cancelar, confirmar a instalação) */
QMessageBox, QDialog { background-color: #FFFFFF; }
QMessageBox QLabel { font-size: 11pt; color: #0E1430; min-width: 380px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #BFC8EA; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #9FAAD9; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #BFC8EA; border-radius: 4px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { height: 0; width: 0; background: none; }
QToolTip { background-color: #0E1430; color: #EEF2FF; border: none; border-radius: 8px; padding: 6px 10px; }

/* Tela da instalação: sem moldura em volta da apresentação; o registro detalhado abre pelo botão ao lado da barra */
QTabWidget::pane { border: none; background: transparent; }
QToolBar { background: transparent; border: none; spacing: 0; }
QLabel#exec-message { color: #56608A; font-size: 10.5pt; padding: 2px 40px 8px 40px; }
