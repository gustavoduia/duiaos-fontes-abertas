/* DuiaOS — estilo do instalador (as cores e os cantos do estilo Futurista, modo claro) */
* { font-family: "Inter", "Noto Sans", sans-serif; font-size: 10.5pt; color: #0E1430; }
#mainApp, QWidget#mainApp { background-color: #F2F4FC; }
QLabel { background: transparent; }
#sidebarApp { background-color: #0A0F1F; }
#logoApp { min-height: 96px; padding: 18px; }
#sidebarMenuApp { padding: 6px; background-color: #0A0F1F; }
QListView#sidebarMenuApp::item { padding: 12px 14px; margin: 2px 6px; border-radius: 12px; color: #C7D6FF; }
QListView#sidebarMenuApp::item:selected { color: #FFFFFF;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #06B6D4, stop:0.5 #3D5BFF, stop:1 #7C3AED); }

QPushButton { background-color: #FFFFFF; border: 1px solid #BFC8EA; border-radius: 17px; padding: 8px 20px; min-height: 18px; }
QPushButton:hover { background-color: #E2E8FF; }
QPushButton:pressed { background-color: #DADFF2; }
QPushButton:disabled { color: #8C95B5; background-color: #EDF0FA; border-color: #DADFF2; }
QPushButton:default, #navigation QPushButton[text*="Pr"], QPushButton#view-button-next {
    color: #FFFFFF; border: none; font-weight: 600;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #06B6D4, stop:0.5 #3D5BFF, stop:1 #7C3AED); }

QLineEdit, QComboBox, QSpinBox, QListWidget, QListView, QTreeView, QTableView, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF; border: 1px solid #BFC8EA; border-radius: 12px; padding: 6px 10px;
    selection-background-color: #3D5BFF; selection-color: #FFFFFF; }
QLineEdit:focus, QComboBox:focus { border: 2px solid #3D5BFF; }
QComboBox::drop-down { border: none; width: 26px; }
QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; }
QProgressBar { border: none; border-radius: 5px; background-color: #E1E6F6; height: 10px; text-align: center; color: transparent; }
QProgressBar::chunk { border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #06B6D4, stop:0.5 #3D5BFF, stop:1 #7C3AED); }
QGroupBox { border: 1px solid #DADFF2; border-radius: 16px; margin-top: 14px; padding: 12px; background-color: #FFFFFF; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #16205C; font-weight: 600; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #BFC8EA; border-radius: 5px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QToolTip { background-color: #0A0F1F; color: #EEF2FF; border: none; border-radius: 8px; padding: 6px 10px; }
QListView#sidebarMenuApp { border: none; border-radius: 0; background-color: #0A0F1F; padding: 6px; }
#sidebarApp QPushButton { background-color: transparent; color: #9AA6C7; border: none; }
#sidebarApp QPushButton:hover { color: #FFFFFF; background-color: #131A30; }
