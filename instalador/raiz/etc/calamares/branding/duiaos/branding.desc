# DuiaOS — identidade do instalador
---
componentName:   duiaos
welcomeStyleCalamares: false
welcomeExpandingLogo: true
# Tela cheia, como o instalador do macOS e a configuração do Windows
windowExpanding: fullscreen
windowSize: 1180px,780px
windowPlacement: center

strings:
    productName:         DuiaOS
    shortProductName:    DuiaOS
    version:             "@VERSAO@"
    shortVersion:        "@VERSAO@"
    versionedName:       DuiaOS @VERSAO@
    shortVersionedName:  DuiaOS @VERSAO@
    bootloaderEntryName: DuiaOS
    productUrl:          https://duiaos.gustavoduia.workers.dev
    supportUrl:          https://duiaos.gustavoduia.workers.dev/suporte/
    knownIssuesUrl:      https://duiaos-docs.gustavoduia.workers.dev/problemas/
    releaseNotesUrl:     https://duiaos.gustavoduia.workers.dev/novidades/
    donateUrl:           https://duiaos.gustavoduia.workers.dev

# Faixas próprias: andamento no alto (calamares-sidebar.qml) e botões embaixo (calamares-navigation.qml)
sidebar: qml,top
navigation: qml,bottom

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "logo.png"

slideshow:               "show.qml"
slideshowAPI: 2

style:
   SidebarBackground:    "#F2F4FC"
   SidebarText:          "#56608A"
   SidebarTextCurrent:   "#0E1430"
   SidebarBackgroundCurrent: "#E7ECFF"
