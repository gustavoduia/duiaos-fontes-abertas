#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# DuiaOS — instala os programas escolhidos na instalação (lista em /var/lib/duiaos/programas-pendentes,
# um por linha). Roda no fim da instalação (--agora) e, para o que faltar, quando o sistema liga com
# internet (duiaos-programas.service). Cada programa instalado sai da lista; lista vazia = arquivo apagado.
#
#   thunderbird   Thunderbird, em português
#   libreoffice   LibreOffice Writer, Calc e Impress, em português
#   vlc           VLC
#   whatsapp      WhatsApp Web como aplicativo (não existe WhatsApp oficial para Linux)
#   telegram      Telegram Desktop (Flathub: não existe no Debian 13)
#   antivirus     ClamAV com a tela ClamTk (livre e gratuito)
set -u
LISTA=/var/lib/duiaos/programas-pendentes
[ -s "${LISTA}" ] || { rm -f "${LISTA}"; exit 0; }
export DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8

com_internet() { curl -fsS -m 8 -o /dev/null https://deb.debian.org/debian/dists/trixie/InRelease; }
if ! com_internet; then
  [ "${1:-}" = "--agora" ] && { echo "SEM-INTERNET"; exit 0; }
  sleep 60; com_internet || exit 75        # o serviço tenta de novo depois
fi

apt-get update -q || true
instalar() { apt-get install -y -q --no-install-recommends "$@"; }

um() {
  case "$1" in
    thunderbird) instalar thunderbird thunderbird-l10n-pt-br ;;
    libreoffice) instalar libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-gtk3 libreoffice-l10n-pt-br ;;
    vlc)         instalar vlc ;;
    telegram)
      # Para todas as contas do computador (o Flathub tem o Telegram para Intel/AMD e ARM)
      flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
        && flatpak install --system -y --noninteractive flathub org.telegram.desktop ;;
    antivirus)   instalar clamav clamav-freshclam clamtk ;;
    whatsapp)
      cat > /usr/share/applications/duiaos-whatsapp-web.desktop <<'ATALHO'
[Desktop Entry]
Type=Application
Name=WhatsApp Web
Comment=Abre o WhatsApp Web numa janela própria
Exec=/usr/lib/duiaos/abrir-aplicativo-web https://web.whatsapp.com/
Icon=internet-chat
Categories=Network;InstantMessaging;
StartupWMClass=web.whatsapp.com
ATALHO
      ;;
    *) echo "desconhecido: $1" >&2; return 0 ;;        # nome que não é da lista: ignora e tira da fila
  esac
}

RESTO="$(mktemp)"
while IFS= read -r PROGRAMA; do
  [ -n "${PROGRAMA}" ] || continue
  if um "${PROGRAMA}"; then echo "OK ${PROGRAMA}"; else echo "FALHOU ${PROGRAMA}"; echo "${PROGRAMA}" >> "${RESTO}"; fi
done < "${LISTA}"
if [ -s "${RESTO}" ]; then cat "${RESTO}" > "${LISTA}"; rm -f "${RESTO}"; exit 75; fi
rm -f "${RESTO}" "${LISTA}"
systemctl disable duiaos-programas.service >/dev/null 2>&1 || true
exit 0
